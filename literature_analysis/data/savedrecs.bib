@article{ WOS:001780705200001,
Author = {Mao, Yongheng and He, Chang and Guo, Wei and Jiang, Lizhong},
Title = {Risk-informed reliability-cost optimization of bridge-mounted overhead
   catenary systems for high-speed railways using a PCA-enhanced surrogate
   model},
Journal = {STRUCTURAL SAFETY},
Year = {2026},
Volume = {122},
Month = {SEP},
Abstract = {Ground-motion uncertainty and variability in structural parameters lead
   to highly dispersed seismic demands in bridge-mounted overhead catenary
   systems (OCS) of high-speed railways, which complicates quantitative
   safety assessment and risk-informed design decisions. This study
   proposes a principal-component-enhanced reliability-cost optimization
   framework to enable efficient estimation of low failure probabilities
   under limited nonlinear time-history analysis budgets. Multiple
   ground-motion intensity measures are compressed into a small set of
   principal components to represent loading scenarios and to reduce
   multicollinearity. A distributionparameterized XGBoost surrogate is
   trained to predict the parameters governing the residual-displacement
   distribution of OCS, and an additional Edgeworth-based tail correction
   is introduced to refine small-probability estimates when upper-tail
   accuracy becomes critical. The resulting failure probabilities are
   coupled with a consequence-based cost model, including material
   consumption, post-event repair, and service downtime, yielding a
   bi-objective trade-off between risk reduction and total cost. Group-wise
   cross-validation is adopted to prevent information leakage and to assess
   generalization across unseen scenario groups. A representative design
   example shows that the schemes recommended by the proposed framework
   reduce failure probability by about 30\% with modest additional cost,
   demonstrating the framework's value for reliability-based decision
   support and seismic risk management of bridge-mounted OCS.},
DOI = {10.1016/j.strusafe.2026.102724},
Article-Number = {102724},
ISSN = {0167-4730},
EISSN = {1879-3355},
Unique-ID = {WOS:001780705200001},
}

@article{ WOS:001520017900005,
Author = {Naserpour, Afshin and Jafari, Abouzar and Zhou, Ying},
Title = {A bio-inspired, demountable modular RC wall system for optimized seismic
   response control in mid- to high-rise buildings},
Journal = {STRUCTURES},
Year = {2025},
Volume = {79},
Month = {SEP},
Abstract = {Conventional RC walls in mid- to high-rise buildings are prone to base
   damage and large drifts during earthquakes. While base-rocking walls
   reduce damage, they remain vulnerable to higher-mode effects and
   excessive drift, affecting both structural and non-structural
   components. This study proposes a novel bio-inspired, demountable
   modular RC wall system that integrates replaceable precast panels and
   rocking columns to enhance force distribution, reduce structural and
   non-structural damage, and improve serviceability and reparability
   during and after earthquakes. Using experimentally validated
   fiber-element models, the proposed system was optimized to reduce and
   evenly distribute seismic responses-inter-story drifts, floor
   accelerations, damage, and demands-across two prototype buildings (12-
   and 24-story) and four design variants. For further investigation,
   finite element models of the optimized variants were developed, and
   their responses assessed under cyclic and seismic loading. Optimization
   showed that panel lengths and reinforcement ratios varied with height,
   with taller walls requiring shorter panels due to higher-mode effects.
   The optimized variants maintained strength and stiffness up to 3.5 \%
   drift, while conventional walls experienced strength loss beyond 2.5-3
   \%. In the optimized variants, plastic strains were concentrated and
   remained manageable due to the system's design. In contrast,
   conventional walls exhibited higher strain levels, resulting in severe
   and widespread damage that is difficult to repair. The optimized
   variants exhibited significantly higher energy dissipation capacity-up
   to 57 \% more than conventional shear wall specimens-due to controlled
   damage patterns and the incorporation of dual pipe dampers. The proposed
   system led to more uniform distribution and significant reductions in
   inter-story drift (up to 42 \%) and floor accelerations (up to 57 \%),
   meeting stricter design constraints (e.g., drift <1.2 \%) and
   highlighting its potential to minimize damage to non-structural
   elements. Structural demands were also more evenly
   distributed-especially in taller walls-demonstrating the system's
   effectiveness in mitigating higher-mode effects. The proposed system's
   detailing enhanced post-earthquake serviceability and reparability,
   underscoring its potential to reduce non-structural damage and support
   resilient high-rise construction.},
DOI = {10.1016/j.istruc.2025.109496},
EarlyAccessDate = {JUN 2025},
Article-Number = {109496},
ISSN = {2352-0124},
ResearcherID-Numbers = {Jafari, Abouzar/JAX-6891-2023},
ORCID-Numbers = {Naserpour, Afshin/0000-0002-3374-4044
   Jafari, Abouzar/0000-0003-0716-1635},
Unique-ID = {WOS:001520017900005},
}

@article{ WOS:001754546000001,
Author = {Gao, Yinan and Shaw, Rajib},
Title = {Paradigm evolution and tension dynamics in disaster recovery research: a
   theoretical synthesis (1980-2025)},
Journal = {JOURNAL OF RISK RESEARCH},
Year = {2026},
Month = {2026 APR 20},
Abstract = {Disaster recovery research has evolved through distinct theoretical
   paradigms, yet systematic understanding of this evolution remains
   fragmented. This study develops a novel analytical framework combining
   paradigm analysis with tension evolution methodology to synthesize
   theoretical development in disaster recovery research from 1980 to 2025.
   Through PRISMA-compliant systematic review, 78 core theoretical papers
   were selected from 775 publications and analyzed using six-dimensional
   paradigm identification and five-tension quantitative coding with high
   inter-rater reliability (Cohen's kappa = 0.82). Three coexisting yet
   temporally differentiated paradigms were identified, with dates
   indicating periods of emergence and dominance rather than exclusive
   boundaries: Return to Normalcy (dominant 1980-2000), characterized by
   engineering rationality and linear reconstruction; Sustainable Recovery
   (dominant 2001-2015), emphasizing Build Back Better principles and
   multi-stakeholder governance; and Transformative Recovery (dominant
   2016-present), focusing on systemic change and social justice. Analysis
   reveals significant paradigm overlap, with 23.1\% of core papers
   exhibiting hybridization spanning adjacent paradigm boundaries.
   Statistical analysis confirmed significant cross-paradigm differences in
   tension intensity (ANOVA, F(2,75) = 18.47, p < 0.001), with composite
   tension indices declining from 2.98 to 2.18 across paradigms. Notably,
   tension evolution reveals differentiated trajectories: ecology-economy
   tensions achieved substantial integration (declining from 3.0 to 1.5),
   while external-local power dynamics remain persistently challenging
   (maintaining intensity above 2.3), demonstrating that paradigm
   transitions involve selective innovation rather than uniform progress.
   The study contributes an integrated `Adaptive Recovery System' framework
   that bridges theoretical fragmentation while providing operational
   guidance aligned with Sendai Framework priorities. These findings
   suggest that effective recovery governance requires paradigm-aware
   policy design combined with adaptive mechanisms for managing persistent
   tensions, offering critical insights for advancing both theoretical
   coherence and policy-practice integration in disaster recovery.},
DOI = {10.1080/13669877.2026.2660363},
EarlyAccessDate = {APR 2026},
ISSN = {1366-9877},
EISSN = {1466-4461},
Unique-ID = {WOS:001754546000001},
}

@article{ WOS:000708440500012,
Author = {Yuan, Guangzhe Frank and Shi, Wei and Elhai, Jon D. and Montag,
   Christian and Chang, Kay and Jackson, Todd and Hall, Brian J.},
Title = {Gaming to cope: Applying network analysis to understand the relationship
   between posttraumatic stress symptoms and internet gaming disorder
   symptoms among disaster-exposed Chinese young adults},
Journal = {ADDICTIVE BEHAVIORS},
Year = {2022},
Volume = {124},
Month = {JAN},
Abstract = {Research has demonstrated that posttraumatic stress disorder (PTSD) is
   associated with internet-related problematic behaviors. However, studies
   have not explored the linkage between PTSD symptoms and internet gaming
   disorder (IGD) symptoms. The current study aimed to investigate the
   relationship between posttraumatic stress symptoms (PTSS) and IGD
   symptoms via network analysis. We conducted a cross-sectional study with
   341 Chinese young adults directly exposed to a typhoon and examined the
   network structure of PTSS and IGD symptoms, along with bridge symptoms,
   to elucidate how they co-occur. Results indicated that `avoiding
   external reminders' and `anhedonia' were identified as the most central
   symptoms in the PTSD network, whereas `preoccupation,' `gaming despite
   harms', and `loss of control' ranked highest on centrality in the IGD
   network. Two bridge symptoms emerged within the combined PTSD and IGD
   network model: `concentration difficulties' and `conflict due to gaming'
   from among the PTSS and IGD symptoms, respectively. These findings
   reveal novel associations between PTSS and IGD symptoms and provide an
   empirically-based hypothesis for how these two disorders may co-occur
   among individuals exposed to natural disasters.},
DOI = {10.1016/j.addbeh.2021.107096},
EarlyAccessDate = {AUG 2021},
Article-Number = {107096},
ISSN = {0306-4603},
EISSN = {1873-6327},
