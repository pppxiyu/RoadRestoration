@article{ WOS:000363992700016,
Author = {Wang, Shuo and Chou, Eddie Y.},
Title = {Cross-Asset Transportation Project Coordination with Integer Programming
   and Constraint Programming},
Journal = {TRANSPORTATION RESEARCH RECORD},
Year = {2015},
Number = {2482},
Pages = {117-125},
Abstract = {Many asset management systems generate work plans for different asset
   components independently. Coordination of projects between different
   assets, such as pavement and bridge rehabilitations in the same,
   adjacent, or nearby locations, is often performed only on an ad hoc
   basis. Poorly coordinated projects might cause unnecessary traffic
   disruptions and increased agency costs. This paper presents two
   optimization models to coordinate asset projects systematically with the
   application of integer programming and constraint programming. The
   objective of the two models was to maximize the total benefits of the
   projects, including project benefits and coordination benefits, by
   rescheduling some projects subject to budget constraints and project
   timing constraints. The project benefits were assessed on the basis of
   relationship between the asset condition and the vehicle operating cost.
   The project coordination benefits were estimated for road users and
   highway agencies. An example problem was solved to improve an
   uncoordinated work plan consisting of 26 asset preservation projects.
   The results show that the two models yield the same solution and the
   total benefits could be increased significantly by project coordination.
   The models can be implemented by highway agencies to support their
   cross-asset management decisions.},
DOI = {10.3141/2482-15},
ISSN = {0361-1981},
EISSN = {2169-4052},
ORCID-Numbers = {Chou, Eddie/0000-0003-4310-8567},
Unique-ID = {WOS:000363992700016},
}

@article{ WOS:001634755200002,
Author = {Yang, Jun and Zhao, Yulong and Wu, Qi and Wang, Shunjiang},
Title = {Resilience enhancement encryption strategy for cyber-physical energy
   systems under multiple extreme events based on edge graph computing},
Journal = {RELIABILITY ENGINEERING \& SYSTEM SAFETY},
Year = {2026},
Volume = {268},
Month = {APR},
Abstract = {Ensuring the reliability and security of Cyber-Physical Energy Systems
   (CPES) against multiple extreme events is a critical challenge for
   modern energy infrastructure. The deep coupling of information and
   energy in CPES creates vulnerabilities to compound disasters. Physical
   disruptions are exploited by sophisticated cyber-attacks during
   post-disaster recovery, which is a threat scenario that conventional,
   single-layer defenses cannot adequately address. To bridge this gap,
   this paper proposes an integrated resilience enhancement and encryption
   strategy based on edge graph computing. A novel multiple extreme event
   model is first developed, capturing the dynamics of a physical layer
   earthquake combined with a cyber layer eavesdropping-spoofing attack.
   The proposed strategy then employs a dual-layer approach: at the
   physical layer, a minimum cost consensus algorithm facilitates rapid
   topological graph reconstruction; at the cyber layer, a homomorphic hash
   differential privacy encryption method secures communication across the
   cloud-edge-equipment architecture. Hardware-in-the-loop simulation
   results validate the strategy's effectiveness, demonstrating that the
   system can achieve rapid physical restoration while maintaining
   convergent and secure dispatch operations under the combined
   cyber-physical assault. Quantitative analysis further reveals that the
   proposed encryption scheme significantly enhances data integrity,
   exhibiting lower uncertainty and fewer outliers compared to benchmark
   privacy-preserving methods. By providing a unified framework that
   co-optimizes physical recovery and cyber security, this work presents a
   crucial advancement for designing next-generation CPES resilient to
   complex, multi-domain threats.},
DOI = {10.1016/j.ress.2025.111992},
EarlyAccessDate = {DEC 2025},
Article-Number = {111992},
ISSN = {0951-8320},
EISSN = {1879-0836},
ResearcherID-Numbers = {Yang, Jun/AFA-0399-2022
   },
ORCID-Numbers = {Yang, Jun/0000-0003-0599-1416
   WU, QI/0009-0001-0126-373X},
Unique-ID = {WOS:001634755200002},
}

@article{ WOS:000858577000001,
Author = {Minnucci, Lucia and Scozzese, Fabrizio and Carbonari, Sandro and Gara,
   Fabrizio and Dall'Asta, Andrea},
Title = {Innovative Fragility-Based Method for Failure Mechanisms and Damage
   Extension Analysis of Bridges},
Journal = {INFRASTRUCTURES},
Year = {2022},
Volume = {7},
Number = {9},
Month = {SEP},
Abstract = {The seismic assessment of existing bridges is of the utmost importance
   to characterise the main structural deficiencies, estimate the risk,
   prioritise retrofit interventions, or estimate losses and repair costs
   in case of earthquakes. The above tasks require information on the
   damage mechanisms likely to occur as well as on the damage extent over
   the structure. Such types of information are generally not provided by
   classical fragility analysis, which is mainly focused on the evaluation
   of the global performance of the bridge. In this paper, a systematic
   probabilistic methodology for the evaluation of bridge fragility is
   proposed. The methodology aims at offering insight into the failure
   mechanisms most likely to occur and the evolution and extent of damage
   within the bridge structure. First, a mathematical description of the
   proposed analysis methods is given, then an application to a realistic
   case study-a reinforced concrete multi-span simply supported deck
   link-slab bridge-is provided to illustrate the applicability of the
   tool. A nonlinear 3D finite element model is developed, and a
   multiple-stripe (nonlinear dynamic) analysis is performed by using a
   stochastic bidirectional seismic input. The results highlight the
   suitability of the proposed methodology to reveal the main structural
   deficiencies, the relations among different failure mechanisms
   (involving piers, bearings, abutments, etc.), and the expected damage
   extent.},
DOI = {10.3390/infrastructures7090122},
Article-Number = {122},
EISSN = {2412-3811},
ResearcherID-Numbers = {scozzese, fabrizio/AAE-5313-2021
   },
