# Publish only the runnable source, input data, and three visible root files.
# Local experiments, notes, archives, and manuscript files stay on disk.
/*
!/src/
!/data/
!/main.py
!/README.md
!/requirements.txt
!/.gitignore

# Generated files inside published directories.
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.DS_Store
Thumbs.db
*~
