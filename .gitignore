# Publish source, input data, and the selected root files.
# Documents, outputs, experiments, archives, and manuscript files stay local.
/*
!/src/
!/data/
!/main.py
!/README.md
!/requirements.txt
!/.gitignore

# Never publish local documents or generated/archived results.
/doc/
/outputs/

# Generated files inside published directories.
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.DS_Store
Thumbs.db
*~
